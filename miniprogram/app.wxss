page {
  background: #08111f;
  color: #e7f0fb;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell { padding: 28rpx; }
.panel { margin-bottom: 24rpx; padding: 26rpx; border: 1rpx solid #263b56; border-radius: 20rpx; background: #122238; box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, .16); }
.title { display: block; font-size: 40rpx; font-weight: 700; }
.muted { display: block; margin-top: 10rpx; color: #8ea4bf; font-size: 24rpx; line-height: 1.5; }
.label { display: block; margin-bottom: 12rpx; color: #8ea4bf; font-size: 23rpx; }
.input { box-sizing: border-box; width: 100%; padding: 18rpx; border: 1rpx solid #385272; border-radius: 12rpx; color: #e7f0fb; background: #0b1727; }
.row { display: flex; gap: 16rpx; align-items: center; }
.row .field { flex: 1; min-width: 0; }
.button { margin: 22rpx 0 0; border-radius: 12rpx; color: #071226; background: #65d7b1; }
.button[disabled] { color: #8ea4bf; background: #263b56; }
.status { padding: 18rpx; border-radius: 12rpx; color: #b9c9dc; background: rgba(101, 215, 177, .08); font-size: 24rpx; line-height: 1.5; }
.status.error { color: #ffb0ba; background: rgba(255, 119, 135, .09); }
.canvas-wrap { height: 650rpx; overflow: hidden; border-radius: 14rpx; background: #0a1423; }
.chart { width: 100%; height: 100%; }
.hint { display: block; margin-top: 18rpx; color: #8ea4bf; font-size: 22rpx; line-height: 1.5; }
